html, body, [data-testid="stAppViewContainer"], [data-testid="stApp"] {
    background: #0d0c12;
}
.block-container {
    max-width: 1280px;
    padding-top: 1.2rem;
    padding-bottom: 3rem;
}
.encabezado-principal {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.4rem 1.8rem;
    margin-bottom: 1.3rem;
    border-radius: 22px;
    background: linear-gradient(120deg, #32264f, #5b3f7d);
    border: 1px solid rgba(255,255,255,.12);
}
.encabezado-principal h1 { margin: 0; color: white; font-size: 2.25rem; }
.encabezado-principal p { margin: .35rem 0 0; color: #ddd2eb; }
.icono-robot { font-size: 4rem; }
.tarjeta-indicador {
    min-height: 120px;
    padding: 1rem 1.1rem;
    border-radius: 16px;
    background: #191620;
    border: 1px solid rgba(177,145,205,.25);
    border-left: 6px solid #a56ad1;
}
.indicador-titulo { color: #bdb4c8; text-transform: uppercase; font-size: .78rem; font-weight: 700; }
.indicador-valor { color: white; font-size: 1.8rem; font-weight: 850; margin-top: .25rem; }
.indicador-detalle { color: #aaa0b5; font-size: .8rem; margin-top: .25rem; }
.stButton > button { border-radius: 11px; font-weight: 750; }
